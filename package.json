{
  "name": "sitemap-scanner",
  "version": "0.1.0",
  "private": true,
  "description": "Crawl, screenshot, link-check and visually diff a WordPress site between review cycles.",
  "type": "module",
  "bin": {
    "sitemap-scanner": "./dist/cli.js"
  },
  "scripts": {
    "scan": "tsx src/cli.ts scan",
    "report": "tsx src/cli.ts report",
    "serve": "tsx src/cli.ts serve",
    "runs": "tsx src/cli.ts runs",
    "links": "tsx src/cli.ts links",
    "proofread": "tsx src/cli.ts proofread",
    "dismiss": "tsx src/cli.ts dismiss",
    "migrate": "tsx src/cli.ts migrate",
    "prune": "tsx src/cli.ts prune",
    "where": "tsx src/cli.ts where",
    "diff": "tsx src/cli.ts diff",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "postinstall": "playwright install chromium"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1128.0",
    "@aws-sdk/s3-request-presigner": "^3.1128.0",
    "commander": "^12.1.0",
    "dictionary-en": "^4.0.0",
    "dictionary-en-gb": "^3.0.0",
    "fast-xml-parser": "^4.5.0",
    "nspell": "^2.1.5",
    "p-limit": "^6.1.0",
    "pixelmatch": "^6.0.0",
    "playwright": "^1.48.0",
    "pngjs": "^7.0.0",
    "retext": "^9.0.0",
    "retext-indefinite-article": "^5.0.0",
    "retext-quotes": "^6.0.2",
    "retext-repeated-words": "^5.0.0",
    "retext-sentence-spacing": "^6.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/pngjs": "^6.0.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
